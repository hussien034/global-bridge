# Global Bridge — Environment Variables Example
# Copy this file to .env for local development (Node.js 20.12+).

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (SQLite)
DATABASE_URL=file:./sqlite.db

# Applicant CV storage (private local files, not served as public static assets)
UPLOAD_DIR=./data/uploads

# Initial admin account. Created once when the server starts; admin registration is never public.
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
